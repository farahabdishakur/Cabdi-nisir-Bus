# HTTPS automatic (Let's Encrypt).
# app.*: website-ka + /api isla domain-ka (cookie-ga refresh = same-origin; SSE /api/v1/events si toos ah ayuu u flush-gareeyaa)
{$APP_DOMAIN} {
	# SSE (live events) lama cadaadiyo — gzip wuu xannibi karaa event-yada
	@compressible not path /api/v1/events
	encode @compressible gzip
	# Video caddayn ah (alaabta) — 50MB; wax kale 6MB
	@media path_regexp media ^/api/v1/parcels/[^/]+/media$
	request_body @media {
		max_size 50MB
	}
	@notmedia not path_regexp ^/api/v1/parcels/[^/]+/media$
	request_body @notmedia {
		max_size 6MB
	}
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3001
	}
}

# api.*: API toos ah (mustaqbalka: app taleefan / integrations)
{$API_DOMAIN:api.localhost} {
	@compressible not path /api/v1/events
	encode @compressible gzip
	reverse_proxy api:3000
	# Video caddayn ah (alaabta) — 50MB; wax kale 6MB
	@media path_regexp media ^/api/v1/parcels/[^/]+/media$
	request_body @media {
		max_size 50MB
	}
	@notmedia not path_regexp ^/api/v1/parcels/[^/]+/media$
	request_body @notmedia {
		max_size 6MB
	}
}
