# Database
DATABASE_URL="postgresql://cb:cb@localhost:5432/cabdinasir_bus?schema=public"

# JWT — beddel production-ka (ugu yaraan 32 xaraf, random)
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=7

# Server
PORT=3000
CORS_ORIGIN="http://localhost:3001"
TZ_BUSINESS="Africa/Mogadishu"

# Seed — password-ka Super Admin-ka ugu horreeya (waa in la beddelaa marka ugu horreysa)
SEED_SUPER_ADMIN_PHONE="0630000000"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"

# SMS (outbox): "log" = kaliya log (development) · "http" = provider dhab ah (Telesom/Somtel/aggregator)
SMS_PROVIDER="log"
SMS_HTTP_URL=""
SMS_HTTP_TOKEN=""
SMS_SENDER="CabdinasirBus"

# Sawirada alaabta
UPLOAD_DIR="./uploads"

# Background jobs (SMS worker, xusuusinta alaabta, nadiifinta). false = tests
JOBS_ENABLED="true"

# Tests kaliya: true = rate limit way joogsataa
THROTTLE_DISABLED="false"

# Production (docker-compose.prod.yml)
POSTGRES_PASSWORD=""
API_DOMAIN="api.cabdinasirbus.com"

# API docs (/api/docs): production default = false
# SWAGGER_ENABLED="true"

# Proxy hor fadhiya (Caddy/nginx) → "1". Haddii kale ha dejin (X-Forwarded-For been abuur)
# TRUST_PROXY="1"
